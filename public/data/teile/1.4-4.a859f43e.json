[{"id":"BSP-1.4-204","mutterfrageId":"BSP-1.4-204","variante":0,"kapitel":"1.4","stoff":"grundstoff","klassen":["AM","A1","A2","A","B","Mofa","L","T","C1","C","CE","D1","D"],"punkte":3,"typ":"bildauswahl","text":"Welches Zeichen beschränkt die Geschwindigkeit nur für die folgende Strecke auf 30 km/h – nicht für eine Zone?","antworten":[{"text":"Zeichen 278-60: Ende der zulässigen Höchstgeschwindigkeit – 60 km/h","richtig":false,"bild":"signs/vz-278-60.svg","zeichen":"278-60"},{"text":"Zeichen 275-30: Vorgeschriebene Mindestgeschwindigkeit – 30 km/h","richtig":false,"bild":"signs/vz-275-30.svg","zeichen":"275-30"},{"text":"Zeichen 274-30: Zulässige Höchstgeschwindigkeit – 30 km/h","richtig":true,"bild":"signs/vz-274-30.svg","zeichen":"274-30"},{"text":"Zeichen 274.1: Beginn einer Tempo 30-Zone","richtig":false,"bild":"signs/vz-274_1.svg","zeichen":"274.1"}],"erklaerung":"Das runde Schild gilt für eine Strecke. Das eckige Schild mit der Aufschrift „Zone“ gilt für ein ganzes Gebiet, das blaue Rund ist eine Mindestgeschwindigkeit.","medien":{"bild":null,"bildAlt":null,"video":null,"poster":null},"beispiel":true,"quelle":"batch-1:39-bildauswahl.txt","zeichen":["278-60","275-30","274-30","274.1"]},{"id":"BSP-1.4-205","mutterfrageId":"BSP-1.4-205","variante":0,"kapitel":"1.4","stoff":"grundstoff","klassen":["AM","A1","A2","A","B","Mofa","L","T","C1","C","CE","D1","D"],"punkte":3,"typ":"bildauswahl","text":"Welches Zeichen schreibt Ihnen eine Mindestgeschwindigkeit vor?","antworten":[{"text":"Zeichen 274-30: Zulässige Höchstgeschwindigkeit – 30 km/h","richtig":false,"bild":"signs/vz-274-30.svg","zeichen":"274-30"},{"text":"Zeichen 274.1: Beginn einer Tempo 30-Zone","richtig":false,"bild":"signs/vz-274_1.svg","zeichen":"274.1"},{"text":"Zeichen 275-30: Vorgeschriebene Mindestgeschwindigkeit – 30 km/h","richtig":true,"bild":"signs/vz-275-30.svg","zeichen":"275-30"},{"text":"Zeichen 279-30: Ende der vorgeschriebenen Mindestgeschwindigkeit – 30 km/h","richtig":false,"bild":"signs/vz-279-30.svg","zeichen":"279-30"}],"erklaerung":"Eine weiße Zahl auf blauem Rund ist ein Gebot: Sie dürfen nicht langsamer fahren, wenn nicht Straßen-, Verkehrs-, Sicht- oder Wetterverhältnisse dazu zwingen.","medien":{"bild":null,"bildAlt":null,"video":null,"poster":null},"beispiel":true,"quelle":"batch-1:39-bildauswahl.txt","zeichen":["274-30","274.1","275-30","279-30"]},{"id":"BSP-1.4-206","mutterfrageId":"BSP-1.4-206","variante":0,"kapitel":"1.4","stoff":"grundstoff","klassen":["AM","A1","A2","A","B","Mofa","L","T","C1","C","CE","D1","D"],"punkte":3,"typ":"bildauswahl","text":"Welches Zeichen kennzeichnet den Beginn einer Tempo-30-Zone?","antworten":[{"text":"Zeichen 274.1: Beginn einer Tempo 30-Zone","richtig":true,"bild":"signs/vz-274_1.svg","zeichen":"274.1"},{"text":"Zeichen 325.1: Beginn eines verkehrsberuhigten Bereichs","richtig":false,"bild":"signs/vz-325_1.svg","zeichen":"325.1"},{"text":"Zeichen 274-30: Zulässige Höchstgeschwindigkeit – 30 km/h","richtig":false,"bild":"signs/vz-274-30.svg","zeichen":"274-30"},{"text":"Zeichen 290.1: Beginn eines eingeschränkten Haltverbots für eine Zone","richtig":false,"bild":"signs/vz-290_1.svg","zeichen":"290.1"}],"erklaerung":"Das rechteckige Schild mit dem Wort „Zone“ gilt in allen Straßen des Gebiets, bis die Zone durch das passende Ende-Zeichen aufgehoben wird.","medien":{"bild":null,"bildAlt":null,"video":null,"poster":null},"beispiel":true,"quelle":"batch-1:39-bildauswahl.txt","zeichen":["274.1","325.1","274-30","290.1"]},{"id":"BSP-1.4-207","mutterfrageId":"BSP-1.4-207","variante":0,"kapitel":"1.4","stoff":"grundstoff","klassen":["AM","A1","A2","A","B","Mofa","L","T","C1","C","CE","D1","D"],"punkte":4,"typ":"bildauswahl","text":"In welchem Bereich ist Fahrzeugverkehr erlaubt, aber nur mit Schrittgeschwindigkeit, und Kinder dürfen überall spielen?","antworten":[{"text":"Zeichen 274.1: Beginn einer Tempo 30-Zone","richtig":false,"bild":"signs/vz-274_1.svg","zeichen":"274.1"},{"text":"Zeichen 242.1: Beginn einer Fußgängerzone","richtig":false,"bild":"signs/vz-242_1.svg","zeichen":"242.1"},{"text":"Zeichen 239: Gehweg","richtig":false,"bild":"signs/vz-239.svg","zeichen":"239"},{"text":"Zeichen 325.1: Beginn eines verkehrsberuhigten Bereichs","richtig":true,"bild":"signs/vz-325_1.svg","zeichen":"325.1"}],"erklaerung":"Das blaue Schild mit spielendem Kind, Haus und Auto beginnt einen verkehrsberuhigten Bereich. In der Fußgängerzone ist Fahrzeugverkehr ohne Zusatzzeichen gar nicht erlaubt.","medien":{"bild":null,"bildAlt":null,"video":null,"poster":null},"beispiel":true,"quelle":"batch-1:39-bildauswahl.txt","zeichen":["274.1","242.1","239","325.1"]},{"id":"BSP-1.4-208","mutterfrageId":"BSP-1.4-208","variante":0,"kapitel":"1.4","stoff":"grundstoff","klassen":["AM","A1","A2","A","B","Mofa","L","T","C1","C","CE","D1","D"],"punkte":3,"typ":"bildauswahl","text":"Welches Zeichen kennzeichnet den Beginn einer Fußgängerzone?","antworten":[{"text":"Zeichen 239: Gehweg","richtig":false,"bild":"signs/vz-239.svg","zeichen":"239"},{"text":"Zeichen 325.1: Beginn eines verkehrsberuhigten Bereichs","richtig":false,"bild":"signs/vz-325_1.svg","zeichen":"325.1"},{"text":"Zeichen 240: Gemeinsamer Geh- und Radweg","richtig":false,"bild":"signs/vz-240.svg","zeichen":"240"},{"text":"Zeichen 242.1: Beginn einer Fußgängerzone","richtig":true,"bild":"signs/vz-242_1.svg","zeichen":"242.1"}],"erklaerung":"Das eckige Schild mit den Fußgängern kündigt eine Zone an, in der ohne Zusatzzeichen nur zu Fuß Gehende unterwegs sein dürfen.","medien":{"bild":null,"bildAlt":null,"video":null,"poster":null},"beispiel":true,"quelle":"batch-1:39-bildauswahl.txt","zeichen":["239","325.1","240","242.1"]},{"id":"BSP-1.4-209","mutterfrageId":"BSP-1.4-209","variante":0,"kapitel":"1.4","stoff":"grundstoff","klassen":["AM","A1","A2","A","B","Mofa","L","T","C1","C","CE","D1","D"],"punkte":3,"typ":"bildauswahl","text":"Welches Zeichen kennzeichnet den Beginn einer Fahrradstraße?","antworten":[{"text":"Zeichen 240: Gemeinsamer Geh- und Radweg","richtig":false,"bild":"signs/vz-240.svg","zeichen":"240"},{"text":"Zeichen 254: Verbot für Radverkehr","richtig":false,"bild":"signs/vz-254.svg","zeichen":"254"},{"text":"Zeichen 237: Radweg","richtig":false,"bild":"signs/vz-237.svg","zeichen":"237"},{"text":"Zeichen 244.1: Beginn einer Fahrradstraße","richtig":true,"bild":"signs/vz-244_1.svg","zeichen":"244.1"}],"erklaerung":"Auf einer Fahrradstraße dürfen andere Fahrzeuge nur fahren, wenn ein Zusatzzeichen das erlaubt – dann höchstens mit 30 km/h.","medien":{"bild":null,"bildAlt":null,"video":null,"poster":null},"beispiel":true,"quelle":"batch-1:39-bildauswahl.txt","zeichen":["240","254","237","244.1"]},{"id":"BSP-1.4-210","mutterfrageId":"BSP-1.4-210","variante":0,"kapitel":"1.4","stoff":"grundstoff","klassen":["AM","A1","A2","A","B","Mofa","L","T","C1","C","CE","D1","D"],"punkte":3,"typ":"bildauswahl","text":"Welches Zeichen kennzeichnet einen Weg, den sich Radfahrende und Fußgänger ohne feste Aufteilung teilen?","antworten":[{"text":"Zeichen 237: Radweg","richtig":false,"bild":"signs/vz-237.svg","zeichen":"237"},{"text":"Zeichen 241-30: Getrennter Rad- und Gehweg","richtig":false,"bild":"signs/vz-241-30.svg","zeichen":"241-30"},{"text":"Zeichen 240: Gemeinsamer Geh- und Radweg","richtig":true,"bild":"signs/vz-240.svg","zeichen":"240"},{"text":"Zeichen 239: Gehweg","richtig":false,"bild":"signs/vz-239.svg","zeichen":"239"}],"erklaerung":"Beim gemeinsamen Geh- und Radweg sind beide Sinnbilder übereinander dargestellt, beim getrennten Weg durch einen senkrechten Strich nebeneinander.","medien":{"bild":null,"bildAlt":null,"video":null,"poster":null},"beispiel":true,"quelle":"batch-1:39-bildauswahl.txt","zeichen":["237","241-30","240","239"]},{"id":"BSP-1.4-211","mutterfrageId":"BSP-1.4-211","variante":0,"kapitel":"1.4","stoff":"grundstoff","klassen":["AM","A1","A2","A","B","Mofa","L","T","C1","C","CE","D1","D"],"punkte":3,"typ":"bildauswahl","text":"Welches Zeichen schreibt Schneeketten vor?","antworten":[{"text":"Zeichen 268: Schneeketten vorgeschrieben","richtig":true,"bild":"signs/vz-268.svg","zeichen":"268"},{"text":"Zeichen 101: Gefahrstelle","richtig":false,"bild":"signs/vz-101.svg","zeichen":"101"},{"text":"Zeichen 261: Verbot für kennzeichnungspflichtige Kraftfahrzeuge mit gefährlichen Gütern","richtig":false,"bild":"signs/vz-261.svg","zeichen":"261"},{"text":"Zeichen 269: Verbot für Fahrzeuge mit wassergefährdender Ladung","richtig":false,"bild":"signs/vz-269.svg","zeichen":"269"}],"erklaerung":"Auf dem blauen Rund mit dem Reifen mit Ketten dürfen Sie die Straße nur mit aufgezogenen Schneeketten befahren.","medien":{"bild":null,"bildAlt":null,"video":null,"poster":null},"beispiel":true,"quelle":"batch-1:39-bildauswahl.txt","zeichen":["268","101","261","269"]},{"id":"BSP-1.4-212","mutterfrageId":"BSP-1.4-212","variante":0,"kapitel":"1.4","stoff":"grundstoff","klassen":["AM","A1","A2","A","B","L","T","C1","C","CE","D1","D"],"punkte":3,"typ":"bildauswahl","text":"Welches Zeichen kennzeichnet den Beginn einer Autobahn?","antworten":[{"text":"Zeichen 330.1: Autobahn","richtig":true,"bild":"signs/vz-330_1.svg","zeichen":"330.1"},{"text":"Zeichen 331.1: Kraftfahrstraße","richtig":false,"bild":"signs/vz-331_1.svg","zeichen":"331.1"},{"text":"Zeichen 331.2: Ende der Kraftfahrstraße","richtig":false,"bild":"signs/vz-331_2.svg","zeichen":"331.2"},{"text":"Zeichen 330.2: Ende der Autobahn","richtig":false,"bild":"signs/vz-330_2.svg","zeichen":"330.2"}],"erklaerung":"Das Autobahnsymbol ist eine stilisierte Brücke über zwei Fahrbahnen. Die Kraftfahrstraße zeigt ein einzelnes Auto. Durchgestrichene Schilder heben die Regeln wieder auf.","medien":{"bild":null,"bildAlt":null,"video":null,"poster":null},"beispiel":true,"quelle":"batch-1:39-bildauswahl.txt","zeichen":["330.1","331.1","331.2","330.2"]},{"id":"BSP-1.4-213","mutterfrageId":"BSP-1.4-213","variante":0,"kapitel":"1.4","stoff":"grundstoff","klassen":["AM","A1","A2","A","B","L","T","C1","C","CE","D1","D"],"punkte":3,"typ":"bildauswahl","text":"Welches Zeichen kennzeichnet eine Kraftfahrstraße?","antworten":[{"text":"Zeichen 331.1: Kraftfahrstraße","richtig":true,"bild":"signs/vz-331_1.svg","zeichen":"331.1"},{"text":"Zeichen 314: Parken","richtig":false,"bild":"signs/vz-314.svg","zeichen":"314"},{"text":"Zeichen 330.1: Autobahn","richtig":false,"bild":"signs/vz-330_1.svg","zeichen":"330.1"},{"text":"Zeichen 331.2: Ende der Kraftfahrstraße","richtig":false,"bild":"signs/vz-331_2.svg","zeichen":"331.2"}],"erklaerung":"Das weiße Auto auf blauem Grund steht für die Kraftfahrstraße. Sie darf – wie die Autobahn – nur mit Kraftfahrzeugen befahren werden, die bauartbedingt schneller als 60 km/h fahren können.","medien":{"bild":null,"bildAlt":null,"video":null,"poster":null},"beispiel":true,"quelle":"batch-1:39-bildauswahl.txt","zeichen":["331.1","314","330.1","331.2"]},{"id":"BSP-1.4-214","mutterfrageId":"BSP-1.4-214","variante":0,"kapitel":"1.4","stoff":"grundstoff","klassen":["AM","A1","A2","A","B","L","T","C1","C","CE","D1","D"],"punkte":3,"typ":"bildauswahl","text":"Welches Zeichen kennzeichnet eine Einbahnstraße?","antworten":[{"text":"Zeichen 267: Verbot der Einfahrt","richtig":false,"bild":"signs/vz-267.svg","zeichen":"267"},{"text":"Zeichen 222-10: Vorgeschriebene Vorbeifahrt – Links vorbei","richtig":false,"bild":"signs/vz-222-10.svg","zeichen":"222-10"},{"text":"Zeichen 220-10: Einbahnstraße – linksweisend","richtig":true,"bild":"signs/vz-220-10.svg","zeichen":"220-10"},{"text":"Zeichen 209-10: Vorgeschriebene Fahrtrichtung – links","richtig":false,"bild":"signs/vz-209-10.svg","zeichen":"209-10"}],"erklaerung":"Der weiße Pfeil auf dem rechteckigen blauen Schild zeigt die erlaubte Fahrtrichtung in einer Einbahnstraße. Das runde blaue Schild mit Pfeil schreibt nur eine Fahrtrichtung an dieser Stelle vor.","medien":{"bild":null,"bildAlt":null,"video":null,"poster":null},"beispiel":true,"quelle":"batch-1:39-bildauswahl.txt","zeichen":["267","222-10","220-10","209-10"]},{"id":"BSP-1.4-215","mutterfrageId":"BSP-1.4-215","variante":0,"kapitel":"1.4","stoff":"grundstoff","klassen":["AM","A1","A2","A","B","Mofa","L","T","C1","C","CE","D1","D"],"punkte":3,"typ":"bildauswahl","text":"Welches Zeichen schreibt vor, dass Sie rechts an einem Hindernis vorbeifahren müssen?","antworten":[{"text":"Zeichen 222: Vorgeschriebene Vorbeifahrt – Rechts vorbei","richtig":true,"bild":"signs/vz-222.svg","zeichen":"222"},{"text":"Zeichen 222-10: Vorgeschriebene Vorbeifahrt – Links vorbei","richtig":false,"bild":"signs/vz-222-10.svg","zeichen":"222-10"},{"text":"Zeichen 209: Vorgeschriebene Fahrtrichtung – rechts","richtig":false,"bild":"signs/vz-209.svg","zeichen":"209"},{"text":"Zeichen 215: Kreisverkehr","richtig":false,"bild":"signs/vz-215.svg","zeichen":"215"}],"erklaerung":"Der schräg nach unten zeigende Pfeil bedeutet „Vorbeifahrt“: rechts unten heißt rechts vorbei. Der waagerechte gebogene Pfeil ist dagegen eine vorgeschriebene Fahrtrichtung.","medien":{"bild":null,"bildAlt":null,"video":null,"poster":null},"beispiel":true,"quelle":"batch-1:39-bildauswahl.txt","zeichen":["222","222-10","209","215"]},{"id":"BSP-1.4-216","mutterfrageId":"BSP-1.4-216","variante":0,"kapitel":"1.4","stoff":"grundstoff","klassen":["AM","A1","A2","A","B","Mofa","L","T","C1","C","CE","D1","D"],"punkte":3,"typ":"bildauswahl","text":"Welches Zeichen zeigt eine Straße an, die für Fahrzeuge nicht durchgehend befahrbar ist?","antworten":[{"text":"Zeichen 357: Sackgasse","richtig":true,"bild":"signs/vz-357.svg","zeichen":"357"},{"text":"Zeichen 220-10: Einbahnstraße – linksweisend","richtig":false,"bild":"signs/vz-220-10.svg","zeichen":"220-10"},{"text":"Zeichen 267: Verbot der Einfahrt","richtig":false,"bild":"signs/vz-267.svg","zeichen":"267"},{"text":"Zeichen 250: Verbot für Fahrzeuge aller Art","richtig":false,"bild":"signs/vz-250.svg","zeichen":"250"}],"erklaerung":"Der rote Querbalken auf dem weißen „T“ des blauen Schilds bedeutet Sackgasse. Zu Fuß oder mit dem Rad kann es trotzdem weitergehen, wenn das Schild das anzeigt.","medien":{"bild":null,"bildAlt":null,"video":null,"poster":null},"beispiel":true,"quelle":"batch-1:39-bildauswahl.txt","zeichen":["357","220-10","267","250"]},{"id":"BSP-1.4-217","mutterfrageId":"BSP-1.4-217","variante":0,"kapitel":"1.4","stoff":"grundstoff","klassen":["AM","A1","A2","A","B","Mofa","L","T","C1","C","CE","D1","D"],"punkte":3,"typ":"bildauswahl","text":"Welches Zeichen warnt vor einem starken Gefälle?","antworten":[{"text":"Zeichen 108-10: Gefälle – 10 %","richtig":true,"bild":"signs/vz-108-10.svg","zeichen":"108-10"},{"text":"Zeichen 110-10: Steigung – 10 %","richtig":false,"bild":"signs/vz-110-10.svg","zeichen":"110-10"},{"text":"Zeichen 114: Schleuder- oder Rutschgefahr","richtig":false,"bild":"signs/vz-114.svg","zeichen":"114"},{"text":"Zeichen 112: Unebene Fahrbahn","richtig":false,"bild":"signs/vz-112.svg","zeichen":"112"}],"erklaerung":"Beim Gefälle führt die Schräge im Sinnbild nach rechts unten, bei der Steigung nach rechts oben. Vor einem langen Gefälle rechtzeitig einen kleineren Gang wählen.","medien":{"bild":null,"bildAlt":null,"video":null,"poster":null},"beispiel":true,"quelle":"batch-1:39-bildauswahl.txt","zeichen":["108-10","110-10","114","112"]},{"id":"BSP-1.4-218","mutterfrageId":"BSP-1.4-218","variante":0,"kapitel":"1.4","stoff":"grundstoff","klassen":["AM","A1","A2","A","B","L","T","C1","C","CE","D1","D"],"punkte":3,"typ":"bildauswahl","text":"Welches Zeichen warnt vor einer Arbeitsstelle (Baustelle)?","antworten":[{"text":"Zeichen 124: Stau","richtig":false,"bild":"signs/vz-124.svg","zeichen":"124"},{"text":"Zeichen 123: Arbeitsstelle","richtig":true,"bild":"signs/vz-123.svg","zeichen":"123"},{"text":"Zeichen 131: Lichtzeichenanlage","richtig":false,"bild":"signs/vz-131.svg","zeichen":"131"},{"text":"Zeichen 101: Gefahrstelle","richtig":false,"bild":"signs/vz-101.svg","zeichen":"101"}],"erklaerung":"Der Arbeiter mit der Schaufel kündigt die Arbeitsstelle an. Rechnen Sie dort mit Personen, Baufahrzeugen, Verschmutzung und Engstellen.","medien":{"bild":null,"bildAlt":null,"video":null,"poster":null},"beispiel":true,"quelle":"batch-1:39-bildauswahl.txt","zeichen":["124","123","131","101"]},{"id":"BSP-1.4-219","mutterfrageId":"BSP-1.4-219","variante":0,"kapitel":"1.4","stoff":"grundstoff","klassen":["AM","A1","A2","A","B","Mofa","L","T","C1","C","CE","D1","D"],"punkte":3,"typ":"bildauswahl","text":"Welches Zeichen warnt vor Stau?","antworten":[{"text":"Zeichen 125: Gegenverkehr","richtig":false,"bild":"signs/vz-125.svg","zeichen":"125"},{"text":"Zeichen 123: Arbeitsstelle","richtig":false,"bild":"signs/vz-123.svg","zeichen":"123"},{"text":"Zeichen 131: Lichtzeichenanlage","richtig":false,"bild":"signs/vz-131.svg","zeichen":"131"},{"text":"Zeichen 124: Stau","richtig":true,"bild":"signs/vz-124.svg","zeichen":"124"}],"erklaerung":"Die hintereinander stehenden Autos warnen vor Stau. Bremsen Sie rechtzeitig und warnen Sie den nachfolgenden Verkehr bei einem plötzlichen Stauende mit dem Warnblinklicht.","medien":{"bild":null,"bildAlt":null,"video":null,"poster":null},"beispiel":true,"quelle":"batch-1:39-bildauswahl.txt","zeichen":["125","123","131","124"]},{"id":"BSP-1.4-220","mutterfrageId":"BSP-1.4-220","variante":0,"kapitel":"1.4","stoff":"grundstoff","klassen":["AM","A1","A2","A","B","L","T","C1","C","CE","D1","D"],"punkte":3,"typ":"bildauswahl","text":"Welches Zeichen kündigt eine Ampel an?","antworten":[{"text":"Zeichen 102: Kreuzung oder Einmündung – mit Vorfahrt von rechts","richtig":false,"bild":"signs/vz-102.svg","zeichen":"102"},{"text":"Zeichen 124: Stau","richtig":false,"bild":"signs/vz-124.svg","zeichen":"124"},{"text":"Zeichen 151: Bahnübergang","richtig":false,"bild":"signs/vz-151.svg","zeichen":"151"},{"text":"Zeichen 131: Lichtzeichenanlage","richtig":true,"bild":"signs/vz-131.svg","zeichen":"131"}],"erklaerung":"Das Dreieck mit der Lichtzeichenanlage warnt vor einer Ampel, die man oft erst spät sieht – etwa hinter einer Kurve.","medien":{"bild":null,"bildAlt":null,"video":null,"poster":null},"beispiel":true,"quelle":"batch-1:39-bildauswahl.txt","zeichen":["102","124","151","131"]},{"id":"BSP-1.4-221","mutterfrageId":"BSP-1.4-221","variante":0,"kapitel":"1.4","stoff":"grundstoff","klassen":["AM","A1","A2","A","B","Mofa","L","T","C1","C","CE","D1","D"],"punkte":3,"typ":"bildauswahl","text":"Welches Zeichen warnt nur vor Gegenverkehr, ohne den Vorrang zu regeln?","antworten":[{"text":"Zeichen 308: Vorrang vor dem Gegenverkehr","richtig":false,"bild":"signs/vz-308.svg","zeichen":"308"},{"text":"Zeichen 124: Stau","richtig":false,"bild":"signs/vz-124.svg","zeichen":"124"},{"text":"Zeichen 208: Vorrang des Gegenverkehrs","richtig":false,"bild":"signs/vz-208.svg","zeichen":"208"},{"text":"Zeichen 125: Gegenverkehr","richtig":true,"bild":"signs/vz-125.svg","zeichen":"125"}],"erklaerung":"Das Dreieck mit zwei gegenläufigen Pfeilen warnt, dass Sie nach einer Einbahnstrecke oder einem mehrstreifigen Abschnitt wieder mit Gegenverkehr rechnen müssen. Den Vorrang regeln die anderen beiden Pfeilzeichen.","medien":{"bild":null,"bildAlt":null,"video":null,"poster":null},"beispiel":true,"quelle":"batch-1:39-bildauswahl.txt","zeichen":["308","124","208","125"]},{"id":"BSP-1.4-222","mutterfrageId":"BSP-1.4-222","variante":0,"kapitel":"1.4","stoff":"grundstoff","klassen":["AM","A1","A2","A","B","Mofa","L","T","C1","C","CE","D1","D"],"punkte":4,"typ":"bildauswahl","text":"Welche Markierungen dürfen Sie nicht überfahren bzw. nicht befahren?","antworten":[{"text":"Durchgehende Linie","richtig":true,"bild":"signs/eigen/295.svg","zeichen":"295"},{"text":"Leitlinie (unterbrochen)","richtig":false,"bild":"signs/vz-340.svg","zeichen":"340"},{"text":"Sperrfläche","richtig":true,"bild":"signs/eigen/298.svg","zeichen":"298"}],"erklaerung":"Die durchgehende Linie darf auch nicht teilweise überfahren werden, Sperrflächen dürfen nicht benutzt werden. Die unterbrochene Leitlinie dürfen Sie überfahren, wenn dadurch niemand gefährdet wird.","medien":{"bild":null,"bildAlt":null,"video":null,"poster":null},"beispiel":true,"quelle":"batch-1:39-bildauswahl.txt","zeichen":["295","340","298"]},{"id":"BSP-1.4-223","mutterfrageId":"BSP-1.4-223","variante":0,"kapitel":"1.4","stoff":"grundstoff","klassen":["AM","A1","A2","A","B","Mofa","L","T","C1","C","CE","D1","D"],"punkte":3,"typ":"bildauswahl","text":"Welche Markierung zeigt, wo Sie bei Rot, beim Stoppschild oder auf Zeichen eines Polizeibeamten anhalten müssen?","antworten":[{"text":"Sperrfläche","richtig":false,"bild":"signs/eigen/298.svg","zeichen":"298"},{"text":"Haltlinie","richtig":true,"bild":"signs/eigen/294.svg","zeichen":"294"},{"text":"Zebrastreifen","richtig":false,"bild":"signs/eigen/293.svg","zeichen":"293"},{"text":"Zickzacklinie","richtig":false,"bild":"signs/eigen/299.svg","zeichen":"299"}],"erklaerung":"Die breite Querlinie ist die Haltlinie. Sieht man von dort nicht in die Straße, fährt man vorsichtig bis zur Sichtlinie vor und hält dort erneut, wenn nötig.","medien":{"bild":null,"bildAlt":null,"video":null,"poster":null},"beispiel":true,"quelle":"batch-1:39-bildauswahl.txt","zeichen":["298","294","293","299"]},{"id":"BSP-1.4-224","mutterfrageId":"BSP-1.4-224","variante":0,"kapitel":"1.4","stoff":"grundstoff","klassen":["AM","A1","A2","A","B","Mofa","L","T","C1","C","CE","D1","D"],"punkte":3,"typ":"bildauswahl","text":"Welche Markierung kündigt an, dass Ihr Fahrstreifen endet oder bald eine durchgehende Linie beginnt?","antworten":[{"text":"Linkspfeil im Fahrstreifen","richtig":false,"bild":"signs/eigen/297-l.svg","zeichen":"297-l"},{"text":"Rechtspfeil im Fahrstreifen","richtig":false,"bild":"signs/eigen/297-r.svg","zeichen":"297-r"},{"text":"Gebogener Vorankündigungspfeil zwischen den Fahrstreifen","richtig":true,"bild":"signs/eigen/297.1.svg","zeichen":"297.1"}],"erklaerung":"Der Vorankündigungspfeil steht zwischen den Fahrstreifen und deutet zur Seite. Ordnen Sie sich rechtzeitig ein bzw. kehren Sie vom Überholen zurück.","medien":{"bild":null,"bildAlt":null,"video":null,"poster":null},"beispiel":true,"quelle":"batch-1:39-bildauswahl.txt","zeichen":["297-l","297-r","297.1"]},{"id":"BSP-1.4-225","mutterfrageId":"BSP-1.4-225","variante":0,"kapitel":"1.4","stoff":"grundstoff","klassen":["AM","A1","A2","A","B","Mofa","L","T","C1","C","CE","D1","D"],"punkte":4,"typ":"auswahl","text":"Was gilt für diese Markierung auf der Fahrbahn?","antworten":[{"text":"Ich muss rechts von ihr fahren, wenn sie den Gegenverkehr abtrennt","richtig":true},{"text":"Ich darf sie weder überfahren noch auf ihr fahren","richtig":true},{"text":"Ich darf sie zum Überholen kurz überfahren, wenn kein Gegenverkehr kommt","richtig":false}],"erklaerung":"Die durchgehende Linie ist eine Fahrstreifenbegrenzung. Sie darf auch nicht teilweise überfahren werden – auch nicht, wenn gerade niemand entgegenkommt.","medien":{"bild":"signs/eigen/295.svg","bildAlt":"Fahrstreifenbegrenzung und Fahrbahnbegrenzung – Fahrstreifenbegrenzung (durchgehende Linie) (eigene schematische Darstellung)","video":null,"poster":null},"beispiel":true,"quelle":"batch-1:40-eigene-zeichen.txt","zeichen":["295"]},{"id":"BSP-1.4-226","mutterfrageId":"BSP-1.4-226","variante":0,"kapitel":"1.4","stoff":"grundstoff","klassen":["AM","A1","A2","A","B","Mofa","L","T","C1","C","CE","D1","D"],"punkte":3,"typ":"auswahl","text":"Was bedeutet diese Markierung?","antworten":[{"text":"Sie zeigt einen Fahrstreifen nur für Busse an","richtig":false},{"text":"Die Fläche darf ich nicht befahren","richtig":true},{"text":"Ich darf dort kurz halten, wenn ich niemanden behindere","richtig":false}],"erklaerung":"Schraffierte Sperrflächen trennen zum Beispiel Fahrstreifen an Ausfahrten oder Verkehrsinseln. Wer ein Fahrzeug führt, darf sie nicht benutzen – auch nicht zum Halten.","medien":{"bild":"signs/eigen/298.svg","bildAlt":"Sperrfläche (eigene schematische Darstellung)","video":null,"poster":null},"beispiel":true,"quelle":"batch-1:40-eigene-zeichen.txt","zeichen":["298"]},{"id":"BSP-1.4-227","mutterfrageId":"BSP-1.4-227","variante":0,"kapitel":"1.4","stoff":"grundstoff","klassen":["AM","A1","A2","A","B","Mofa","L","T","C1","C","CE","D1","D"],"punkte":3,"typ":"auswahl","text":"Was kündigt Ihnen dieser Pfeil zwischen den Fahrstreifen an?","antworten":[{"text":"Ab hier ist Linksabbiegen verboten","richtig":false},{"text":"Mein Fahrstreifen endet oder es folgt eine durchgehende Linie – ich muss mich in Pfeilrichtung einordnen","richtig":true},{"text":"Ein Überholverbot für Lkw beginnt","richtig":false}],"erklaerung":"Der Vorankündigungspfeil steht zwischen zwei Fahrstreifen und deutet zur Seite. Wer gerade überholt, muss den Vorgang abschließen und rechtzeitig einscheren.","medien":{"bild":"signs/eigen/297.1.svg","bildAlt":"Vorankündigungspfeil (eigene schematische Darstellung)","video":null,"poster":null},"beispiel":true,"quelle":"batch-1:40-eigene-zeichen.txt","zeichen":["297.1"]}]